{
  "expo": {
    "name": "Pixora",
    "slug": "pixora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pixora",
    "backgroundColor": "#080A10",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Pixora to access your photos.",
          "savePhotosPermission": "Allow Pixora to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080A10"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pixora.gallery",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#080A10"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
